#!/bin/sh
# Gate B rcS - OpenRC integration (BusyBox init still PID 1, OpenRC runs as service)
echo "rcS: meowOS Gate B (OpenRC)"
# Ensure essential dirs
mkdir -p /run /tmp /var/log
chmod 1777 /tmp
# Set hostname
/bin/hostname -F /etc/hostname 2>/dev/null || hostname meowOS
# Welcome marker for QEMU tests (Gate A compatibility)
echo "Welcome to meowOS"
echo "BOOT_MARKER: userspace ready"
# Try to start OpenRC if available (Gate B)
if [ -x /sbin/openrc ] || [ -x /usr/sbin/openrc ]; then
  OPENRC_BIN="/sbin/openrc"
  [ -x /usr/sbin/openrc ] && OPENRC_BIN="/usr/sbin/openrc"
  echo "rcS: Starting OpenRC ($OPENRC_BIN)..."
  # OpenRC expects /run/openrc to exist
  mkdir -p /run/openrc 2>/dev/null || true
  # Run OpenRC sysinit, boot, and default runlevels
  # Use --no-stop to avoid stopping already running services
  $OPENRC_BIN sysinit 2>&1 | head -n 50 || true
  $OPENRC_BIN boot 2>&1 | head -n 50 || true
  $OPENRC_BIN default 2>&1 | head -n 50 || true
  # Check if meowos-mark service ran (it prints openrc ready)
  if [ -f /run/meowos-openrc-ready ]; then
    echo "BOOT_MARKER: openrc ready"
  else
    # Fallback: meowos-mark may not have run, try to start it directly
    if [ -x /etc/init.d/meowos-mark ]; then
      /etc/init.d/meowos-mark start 2>&1 | head -n 20 || true
      if [ -f /run/meowos-openrc-ready ]; then
        echo "BOOT_MARKER: openrc ready"
      else
        # Direct fallback
        echo "BOOT_MARKER: openrc ready (fallback)"
        touch /run/meowos-openrc-ready 2>/dev/null || true
      fi
    else
      echo "BOOT_MARKER: openrc ready (no meowos-mark service)"
      touch /run/meowos-openrc-ready 2>/dev/null || true
    fi
  fi
else
  echo "rcS: OpenRC not found, using BusyBox init only"
fi
